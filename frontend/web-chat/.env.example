# Bu dosyayi kopyalayip ".env" adiyla kaydet.
#
# Create React App yalnizca "REACT_APP_" onekli degiskenleri okur ve
# bunlari BUILD sirasinda pakete gomer -- calisma aninda okunmaz.
# Degeri degistirirsen yeniden build/deploy gerekir.
#
# Backend'in gercek portu launchSettings.json'da tanimli: 5165
REACT_APP_API_URL=http://localhost:5165
